# Copy to .env and adjust if your setup differs. No secrets belong here.

# Where the relay reaches the Clash Verge mixed-port on the host Mac.
CLASH_SOCKS_HOST=host.docker.internal
CLASH_SOCKS_PORT=7897

# Port sing-box listens on for TPROXY inside the container netns.
TPROXY_PORT=7893

# Set to "true" only if SOCKS5 UDP ASSOCIATE is broken in your environment
# (see scripts/socks5_udp_probe.py): rejects UDP/443 so HTTP/3 clients fall
# back to TCP instead of hanging. DNS stays proxied either way.
BLOCK_QUIC=false
