# Copy to .env and adjust if your setup differs. No secrets belong here.

# Where the relay reaches the local proxy's SOCKS5 port (Clash Verge
# mixed-port by default) on the Docker host.
CLASH_SOCKS_HOST=host.docker.internal
CLASH_SOCKS_PORT=7897

# Name this gateway registers as in your tailnet.
GW_NODE_NAME=clash-gw

# Uncomment to use a self-hosted control plane (Headscale) instead of the
# Tailscale SaaS, and optionally point setup.sh at its admin UI.
#TS_LOGIN_SERVER=https://headscale.example.com
#TS_ADMIN_URL=https://headscale.example.com/admin

# Port sing-box listens on for TPROXY inside the container netns.
TPROXY_PORT=7893

# Set to "true" only if SOCKS5 UDP ASSOCIATE is broken in your environment
# (see scripts/socks5_udp_probe.py): rejects UDP/443 so HTTP/3 clients fall
# back to TCP instead of hanging. DNS stays proxied either way.
BLOCK_QUIC=false
